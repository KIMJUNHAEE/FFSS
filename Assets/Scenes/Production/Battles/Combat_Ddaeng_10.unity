    - target: {fileID: 3499351003127002580, guid: 4b251608e4ccfdd4196c58ba04821ef3, type: 3}
      propertyPath: m_text
      value: "<color=#FFD96A><b>\uC5F4 \uBC88\uC9F8 \uC2DC\uACC4</b></color>\n0\uC5D0\uC11C
        \uCD5C\uC885\uAE30\uAC00 \uBC1C\uB3D9\uD55C\uB2E4. <color=#FFD35A><b>\uACA9\uD30C</b></color>\uB85C
        \uC2DC\uAC04\uC744 \uB2A6\uCD98\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4096944248549511623, guid: 4b251608e4ccfdd4196c58ba04821ef3, type: 3}
      propertyPath: m_text
      value: "<color=#FFD96A><b>\uAD00\uB828 \uC6A9\uC5B4</b></color>\n<color=#F6B4FF><b>\uC804\uC6A9\uD328</b></color> 
        \uD574\uB2F9 \uC801\uB9CC \uC0AC\uC6A9\uD558\uB294 \uC12F\uB2E4 \uCE74\uB4DC\uC57C.
        \uC608\uACE0\uB41C \uC870\uAC74\uC744 \uB9CC\uC871\uD558\uBA74 \uAE30\uC220\uC5D0
        \uCD94\uAC00 \uD6A8\uACFC\uAC00 \uBD99\uC5B4.\n<color=#FFD35A><b>\uACA9\uD30C</b></color> 
        \uACF5\uBC29 \uCC28\uC774\uB85C \uADE0\uD615 \uAC8C\uC774\uC9C0\uB97C \uCC44\uC6B0\uACE0
        \uAC00\uB4DD \uCC28\uBA74 \uC801 \uD589\uB3D9\uC744 \uB04A\uC5B4.\n<color=#FFD35A><b>\uC57D\uC810</b></color> 
        \uC801\uC5D0\uAC8C \uD45C\uC2DC\uB41C \uBB38\uC591\uACFC \uB9DE\uB294 \uCE74\uB4DC
        \uBE44\uC728\uB85C \uCD94\uAC00 \uD6A8\uACFC\uB97C \uB178\uB824.\n<color=#FFD35A><b>\uC5F4
        \uBC88\uC9F8 \uC2DC\uACC4</b></color>  0\uC5D0\uC11C \uCD5C\uC885\uAE30\uAC00
        \uBC1C\uB3D9\uD55C\uB2E4. \uACA9\uD30C\uB85C \uC2DC\uAC04\uC744 \uB2A6\uCD98\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4742035050093112401, guid: 4b251608e4ccfdd4196c58ba04821ef3, type: 3}
      propertyPath: m_Name
      value: EnemyCombatGuide
      objectReference: {fileID: 0}
    - target: {fileID: 5047532612304296658, guid: 4b251608e4ccfdd4196c58ba04821ef3, type: 3}
      propertyPath: m_text
      value: "<color=#FFD96A><b>\uC804\uC6A9\uD328</b></color>\n<color=#F6B4FF><b>\uB2E8\uD48D
        \uC2ED\uC5F0\uD328</b></color>  \xB7  10\uC6D4\uD328\n4\uD134 \uC2DC\uC791\uC5D0
        \uD55C \uBC88\uB9CC \uD310\uC815 \xB7 \uB4F1\uC7A5\uB960 45% / \uB300\uC751
        30% / \uBC18\uBCF5 \uC2E4\uC218 75% \xB7 \uC2E4\uD328 \uC2DC \uC7AC\uC2DC\uB3C4
        \uC5C6\uC74C\n10\uC6D4\uACFC \uB9CC\uB098\uBA74 \uC871\uBCF4 +2, \uC704\uB825
        +3, HP \uCD94\uAC00 2, \uC587\uC740 \uAC8C\uC774\uC9C0 +2"
