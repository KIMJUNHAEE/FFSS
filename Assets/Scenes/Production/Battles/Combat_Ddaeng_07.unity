    - target: {fileID: 3499351003127002580, guid: 4b251608e4ccfdd4196c58ba04821ef3, type: 3}
      propertyPath: m_text
      value: "<color=#FFD96A><b>\uC9C4\uB3D9</b></color>\n3\uC5D0\uC11C \uB2E4\uC74C
        \uADE0\uD615 \uD53C\uD574\uAC00 \uAC15\uD654\uB41C\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4096944248549511623, guid: 4b251608e4ccfdd4196c58ba04821ef3, type: 3}
      propertyPath: m_text
      value: "<color=#FFD96A><b>\uAD00\uB828 \uC6A9\uC5B4</b></color>\n<color=#F6B4FF><b>\uC804\uC6A9\uD328</b></color> 
        \uD574\uB2F9 \uC801\uB9CC \uC0AC\uC6A9\uD558\uB294 \uC12F\uB2E4 \uCE74\uB4DC\uC57C.
        \uC608\uACE0\uB41C \uC870\uAC74\uC744 \uB9CC\uC871\uD558\uBA74 \uAE30\uC220\uC5D0
        \uCD94\uAC00 \uD6A8\uACFC\uAC00 \uBD99\uC5B4.\n<color=#FFD35A><b>\uACA9\uD30C</b></color> 
        \uACF5\uBC29 \uCC28\uC774\uB85C \uADE0\uD615 \uAC8C\uC774\uC9C0\uB97C \uCC44\uC6B0\uACE0
        \uAC00\uB4DD \uCC28\uBA74 \uC801 \uD589\uB3D9\uC744 \uB04A\uC5B4.\n<color=#FFD35A><b>\uC57D\uC810</b></color> 
        \uC801\uC5D0\uAC8C \uD45C\uC2DC\uB41C \uBB38\uC591\uACFC \uB9DE\uB294 \uCE74\uB4DC
        \uBE44\uC728\uB85C \uCD94\uAC00 \uD6A8\uACFC\uB97C \uB178\uB824.\n<color=#FFD35A><b>\uC9C4\uB3D9</b></color> 
        3\uC5D0\uC11C \uB2E4\uC74C \uADE0\uD615 \uD53C\uD574\uAC00 \uAC15\uD654\uB41C\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4742035050093112401, guid: 4b251608e4ccfdd4196c58ba04821ef3, type: 3}
      propertyPath: m_Name
